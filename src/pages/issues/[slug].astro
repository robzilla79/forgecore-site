---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import IssueHero from "../../components/IssueHero.astro";
import WorkflowVisual from "../../components/WorkflowVisual.astro";

export async function getStaticPaths() {
  const issues = await getCollection("issues");
  return issues.map((issue) => ({
    params: { slug: issue.slug },
    props: { issue },
  }));
}

const { issue } = Astro.props as { issue: CollectionEntry<"issues"> };
const { data, body } = issue;

function videoEmbedUrl(url?: string) {
  if (!url) return "";

  try {
    const parsed = new URL(url);
    const host = parsed.hostname.replace(/^www\./, "");

    if (host === "youtube.com" || host === "m.youtube.com") {
      const videoId = parsed.searchParams.get("v");
      return videoId ? `https://www.youtube-nocookie.com/embed/${videoId}` : url;
    }

    if (host === "youtu.be") {
      const videoId = parsed.pathname.replace(/^\//, "");
      return videoId ? `https://www.youtube-nocookie.com/embed/${videoId}` : url;
    }

    if (host === "vimeo.com") {
      const videoId = parsed.pathname.split("/").filter(Boolean)[0];
      return videoId ? `https://player.vimeo.com/video/${videoId}` : url;
    }
  } catch {
    return "";
  }

  return url;
}

const embedUrl = videoEmbedUrl(data.videoUrl);
const workflowSteps = [
  "Find the reader's practical job-to-be-done",
  "Choose the lightest AI tool or workflow that solves it",
  "Ship a repeatable system before adding more complexity",
];
---

<html lang="en">
  <head>
    <title>{data.title} · Forgecore AI Dispatch</title>
  </head>
  <body class="bg-slate-950 text-slate-50">
    <main class="max-w-3xl mx-auto px-4 py-10 space-y-8">
      <header class="space-y-3">
        <p class="text-sm text-cyan-300 uppercase tracking-wide">
          Forgecore AI Dispatch #{data.issueNumber}
        </p>
        <h1 class="text-3xl md:text-4xl font-semibold">
          {data.title}
        </h1>
        <p class="text-sm text-slate-400">
          {data.date.toISOString().slice(0, 10)}
        </p>
        {data.tags?.length && (
          <div class="flex flex-wrap gap-2 mt-2">
            {data.tags.map((tag) => (
              <span
                class="px-3 py-1 rounded-full border border-cyan-400/40 text-xs text-cyan-200 bg-slate-900/60"
              >
                {tag}
              </span>
            ))}
          </div>
        )}
        <p class="text-slate-300 mt-3">
          {data.description}
        </p>
      </header>

      <IssueHero
        title={data.title}
        description={data.description}
        heroImage={data.heroImage}
        tags={data.tags}
      />

      <WorkflowVisual
        type={data.visualType || "workflow"}
        title="The ForgeCore operator path"
        steps={workflowSteps}
      />

      {embedUrl && (
        <section class="video-block" aria-label="Related video">
          <div>
            <p class="video-eyebrow">Watch</p>
            <h2>{data.videoTitle || "Related operator walkthrough"}</h2>
          </div>
          <div class="video-frame">
            <iframe
              src={embedUrl}
              title={data.videoTitle || data.title}
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        </section>
      )}

      <article class="prose prose-invert max-w-none">
        {body}
      </article>
    </main>
  </body>
</html>

<style>
  .video-block {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 2.25rem;
    border: 1px solid rgba(34, 211, 238, 0.24);
    border-radius: 1.5rem;
    background: rgba(15, 23, 42, 0.72);
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .video-eyebrow {
    margin: 0 0 0.25rem;
    color: #67e8f9;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .video-block h2 {
    margin: 0;
    color: white;
    font-size: clamp(1.25rem, 3vw, 2rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .video-frame {
    position: relative;
    overflow: hidden;
    width: 100%;
    border-radius: 1rem;
    background: #020617;
    aspect-ratio: 16 / 9;
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
